# HandMadeHub frontend environment — copy to .env.local and fill in.
# Network the wallet must be connected to (the DApp validates this).
VITE_NETWORK=preprod
# Deployed HandMadeHub contract address on the Preprod network.
# Fill this after `npm run deploy -- --network preprod` prints it.
VITE_CONTRACT_ADDRESS=
# Midnight Preprod indexer GraphQL endpoint.
VITE_INDEXER_URL=https://indexer.preprod.midnight.network/api/v4/graphql
